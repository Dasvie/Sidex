# 복사해서 .env.local 로 쓴다. 이 파일에는 실제 값을 넣지 않는다.

# 데이터베이스. 비우면 로컬 PGlite(./.pglite)로 돈다. Vercel에서는 Neon 주소를 넣는다.
DATABASE_URL=

# Auth.js. `npx auth secret` 으로 만든다.
AUTH_SECRET=
# 배포 주소. 로컬은 비워도 된다.
AUTH_URL=
NEXT_PUBLIC_SITE_URL=

# 로그인 제공자. 값이 있는 것만 로그인 화면에 버튼이 생긴다.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=
AUTH_NAVER_ID=
AUTH_NAVER_SECRET=

# 이미지 저장소(Vercel Blob). 비우면 로고는 파비콘, 스크린샷·프로필 사진 업로드는 꺼진다.
BLOB_READ_WRITE_TOKEN=

# 도우미(챗봇)와 기획 기록 초안. 비우면 화면 오른쪽 아래 도우미와 초안 버튼이 뜨지 않는다.
ANTHROPIC_API_KEY=

# 요청 제한(선택). 비우면 인스턴스 메모리로 센다. Vercel → Storage → Upstash Redis 가 자동으로 넣는다.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 개발 서버 전용. 모든 요청을 이 핸들의 회원으로 본다(기본 sidex). 로그아웃 상태를 보려면 빈 값으로.
# 프로덕션 빌드에서는 무시된다.
DEV_USER_HANDLE=sidex
